# ─────────────────────────────────────────────────────────────
# Пример файла переменных окружения.
#
# Скопируй его в .env и подставь свои значения:
#   cp .env.example .env
#
# .env НИКОГДА не попадает в git — там лежат секреты.
#
# Значения проверяются при запуске приложения. Если чего-то не хватает
# или значение неверное, приложение не запустится и напишет, что именно
# не так. Проверить настройки, не запуская приложение:
#   pnpm env:check
# ─────────────────────────────────────────────────────────────

# Окружение: development | test | production
NODE_ENV=development

# Публичный адрес платформы. Используется в ссылках из писем и Telegram.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── База данных (подключается на шаге F4) ───
# Порт 5433, а не стандартный 5432 — чтобы не конфликтовать с PostgreSQL,
# который мог быть установлен на компьютере раньше (см. docker-compose.yml).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/guitar_club

# Проверка входа.
#
# false — для локального осмотра: закрытая зона открыта без входа,
#         а войти под участником можно служебным входом /dev/login.
# true  — обязательно на боевом сервере. Приложение с false в производственной
#         среде не запустится: это защита от «забыли переключить».
AUTH_ENABLED=false

# Почта владельца платформы.
# Кто первым войдёт с этим адресом, получит роль владельца. Команда
# `pnpm db:seed` создаёт такой аккаунт заранее. Дальше права меняются
# в интерфейсе или командой `pnpm role:grant <почта> owner`.
OWNER_EMAIL=

# ─── Почта: коды входа ───
# Вход на платформу — по коду, который приходит на почту (ADR-0030).
#
# console — письма не уходят, а печатаются в окне `pnpm dev`. Для разработки.
# smtp    — настоящая отправка через сервис рассылки. На боевом сервере
#           обязательно: с console приложение там не запустится.
EMAIL_PROVIDER=console
# Отправитель, например: Гитарный клуб <noreply@ваш-домен.ru>
EMAIL_FROM=
# Настройки SMTP — в панели сервиса рассылки. Порт обычно 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ─── Telegram ───
# Бот нужен для подключения Telegram к аккаунту: так платформа узнаёт,
# что подписка оплачена (участник в закрытом канале).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секрет для проверки, что вебхук пришёл действительно от Telegram
TELEGRAM_WEBHOOK_SECRET=
# ID закрытого канала клуба — источник истины о подписке
TELEGRAM_CHANNEL_ID=

# Адрес Telegram Bot API. Пусто — сам Telegram (https://api.telegram.org).
# Если из страны размещения сервера Telegram недоступен, сюда ставится
# адрес промежуточного сервера за рубежом (см. docs/OPERATIONS.md).
TELEGRAM_API_BASE_URL=

# Кнопка «Войти через Telegram» на экране входа: true | false.
# Выключена: она не работает там, где сайт Telegram заблокирован.
TELEGRAM_LOGIN_ENABLED=false

# ─── Toolsy: сервис оплаты подписки (docs/OPERATIONS.md) ───
# Toolsy сам сообщает платформе об оплатах и отменах — в обход Telegram.
# Задаются оба ключа или ни одного. Пусто — подписка подтверждается
# только членством в закрытом чате.
TOOLSY_API_KEY=
TOOLSY_WEBHOOK_SECRET=
# Продукт, который считается подпиской на клуб. Пусто — любой продукт проекта.
TOOLSY_PRODUCT_ID=
# Пусто — https://api.toolsy.bot
TOOLSY_API_BASE_URL=

# ─── Подпись сессий ───
# ОБЯЗАТЕЛЕН: без него вход не работает вовсе — ни через Telegram,
# ни служебный. Команда `pnpm demo` подставляет значение сама.
# Сгенерировать вручную: openssl rand -base64 32
# На боевом сервере значение обязано отличаться от локального.
SESSION_SECRET=

# ─── Хранилище файлов ───
# local — файлы лежат в папке .storage рядом с проектом. Годится для
#         осмотра и разработки, не годится для боевого сервера.
# s3    — S3-совместимое хранилище (Selectel, Timeweb и подобные).
STORAGE_PROVIDER=local
S3_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Видеохостинг ───
# kinescope | none
# none — видео не показывается вовсе. Так проект можно поднять и посмотреть
# все экраны, не заводя учётной записи и не платя ни за что.
VIDEO_PROVIDER=none

# Токен API Kinescope: панель → Настройки → API-токены. Формат UUID.
VIDEO_API_KEY=
# Идентификатор проекта в Kinescope, куда складываются ролики.
VIDEO_LIBRARY_ID=

# Логин и пароль, под которыми Kinescope обращается к нам за разрешением
# на воспроизведение. Придумываются вами и прописываются в Kinescope
# командой pnpm kinescope:setup. В производственной среде обязательны.
#   Пароль сгенерировать: openssl rand -base64 24
VIDEO_AUTH_USER=
VIDEO_AUTH_PASSWORD=

# Ролик для демонстрационных данных. Загрузите одно видео в Kinescope
# и вставьте сюда его идентификатор — тогда pnpm db:demo привяжет его
# к разбору «Nothing Else Matters» и плеер будет что показать.
DEMO_VIDEO_ID=

# ─── Наблюдаемость (необязательно) ───
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
